+class RetainedReadinessControls(unittest.TestCase):
+    """Read actual completed evidence; mutations are in-memory negative controls."""
+    @classmethod
+    def setUpClass(cls):
+        path = ROOT / "docs/krikri-marker-grammar-build-continuation-2026-11-28/native_prepare.json"
+        if hashlib.sha256(path.read_bytes()).hexdigest() != "92c674e206ac013d90e6efd1f1570152f1d07682e138915047aba6146640ad2c":
+            raise ValueError("The exact reviewed native readiness report changed.")
+        cls.native = read(path)
+
+    @staticmethod
+    def record(item):
+        path = Path(item["path"])
+        if path.stat().st_size != item["bytes"] or hashlib.sha256(path.read_bytes()).hexdigest() != item["sha256"]:
+            raise ValueError("Retained raw native HTTP evidence changed.")
+        return path
+
+    def check(self, native):
+        return require_http_receipts(native, self.record, "0.40.12")
+
+    def test_exact_actual_one_refusal_and_23_raw_responses(self):
+        self.assertEqual(self.check(self.native), {"initial_connection_refusals": 1,
+            "raw_http_responses": 23, "successful_version_observed": True})
+
+    def test_old_gate_failure_is_reproduced_without_native_calls(self):
+        with self.assertRaises(KeyError) as caught:
+            for call in self.native["http_calls"]:
+                self.record(call["raw_response"])
+        self.assertEqual(caught.exception.args, ("raw_response",))
+
+    def test_changed_startup_error_shape_or_endpoint_rejected(self):
+        for key, value in (("path", "/api/chat"), ("kind", "render"), ("port", 40931),
+                           ("request", {}), ("timeout_seconds", 10.0), ("complete", True),
+                           ("error", {"type": "URLError", "message": "timed out"}),
+                           ("raw_response", None), ("http_status", 200), ("response", {})):
+            native = copy.deepcopy(self.native); native["http_calls"][0][key] = value
+            with self.subTest(key=key), self.assertRaises(ValueError): self.check(native)
+
+    def test_refusal_after_readiness_or_repeated_refusal_rejected(self):
+        for target in (1, 4, 22):
+            native = copy.deepcopy(self.native)
+            refusal = copy.deepcopy(native["http_calls"][0]); refusal["index"] = target
+            native["http_calls"][target] = refusal
+            with self.subTest(target=target), self.assertRaises(ValueError): self.check(native)
+
+    def test_every_success_requires_raw_response_and_complete_status(self):
+        for index in range(1, 24):
+            for field in ("raw_response", "response", "complete", "http_status"):
+                native = copy.deepcopy(self.native); native["http_calls"][index].pop(field)
+                with self.subTest(index=index, field=field), self.assertRaises(ValueError): self.check(native)
+
+    def test_raw_json_mismatch_error_or_wrong_readiness_version_rejected(self):
+        for key, value in (("response", {"version": "wrong"}),
+                           ("error", {"type": "URLError", "message": "unexpected"}),
+                           ("http_status", 500)):
+            native = copy.deepcopy(self.native); native["http_calls"][1][key] = value
+            with self.subTest(key=key), self.assertRaises(ValueError): self.check(native)
+
+    def test_call_index_or_no_successful_readiness_rejected(self):
+        native = copy.deepcopy(self.native); native["http_calls"][1]["index"] = 5
+        with self.assertRaises(ValueError): self.check(native)
+        native = copy.deepcopy(self.native); native["http_calls"] = native["http_calls"][:1]
+        with self.assertRaises(ValueError): self.check(native)
