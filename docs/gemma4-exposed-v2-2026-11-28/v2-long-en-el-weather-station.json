          "text": "\u039a\u03b1\u03c4\u03ac \u03c4\u03b7\u03bd \u03b5\u03c0\u03b9\u03b8\u03b5\u03ce\u03c1\u03b7\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03ba\u03b1\u03b9\u03c1\u03b9\u03ba\u03bf\u03cd \u03c3\u03c4\u03b1\u03b8\u03bc\u03bf\u03cd \u03c3\u03c4\u03b7\u03bd \u03c0\u03bb\u03b1\u03b3\u03b9\u03ac, \u03b7 Iris \u03bc\u03b5\u03c4\u03c1\u03ae\u03b8\u03b7\u03ba\u03b5 7 \u03b5\u03bd\u03b5\u03c1\u03b3\u03bf\u03c0\u03bf\u03b9\u03b7\u03bc\u03ad\u03bd\u03bf \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b5\u03c2 \u03ba\u03b1\u03b9 11 \u03bc\u03b7 \u03c7\u03c1\u03b7\u03c3\u03b9\u03bc\u03bf\u03c0\u03bf\u03b9\u03b7\u03bc\u03ad\u03bd\u03b1 \u0628\u0631\u0627\u06a9\u062a \u03c3\u03c4\u03b5\u03c1\u03ad\u03c9\u03c3\u03b7\u03c2. \u039f\u03b9 \u0628\u0631\u0627\u06a9\u062a \u03ae\u03c4\u03b1\u03bd \u03b5\u03c6\u03b5\u03b4\u03c1\u03b9\u03ba\u03ac \u03b5\u03be\u03b1\u03c1\u03c4\u03ae\u03bc\u03b1\u03c4\u03b1, \u03cc\u03c7\u03b9 \u03b5\u03c0\u03b9\u03c0\u03bb\u03ad\u03bf\u03bd \u03b1\u03b9\u03c3\u03b8\u03b7\u03c4\u03ae\u03c1\u03b5\u03c2. \u039f Theodoros \u03ad\u03b3\u03c1\u03b1\u03c8\u03b5 \u03c4\u03bf\u03bd \u03b1\u03bd\u03b1\u03b3\u03bd\u03c9\u03c1\u03b9\u03c3\u03c4\u03b9\u03ba\u03cc \u03ba\u03ac\u03b8\u03b5 \u03cc\u03c1\u03b3\u03bf\u03c5 \u03b4\u03af\u03c0\u03bb\u03b1 \u03c3\u03c4\u03b7 \u03b8\u03ad\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03c3\u03b5 \u03ad\u03bd\u03b1 \u03c3\u03ba\u03b1\u03bb\u03af\u03b4\u03b9, \u03ce\u03c3\u03c4\u03b5 \u03ad\u03bd\u03b1\u03c2 \u03bc\u03b5\u03bb\u03bb\u03bf\u03bd\u03c4\u03b9\u03ba\u03cc\u03c2 \u03b1\u03bd\u03b1\u03b3\u03bd\u03ce\u03c3\u03c4\u03b7\u03c2 \u03bd\u03b1 \u03bc\u03c0\u03bf\u03c1\u03b5\u03af \u03bd\u03b1 \u03b4\u03b9\u03b1\u03c0\u03b9\u03c3\u03c4\u03ce\u03c3\u03b5\u03b9 \u03b1\u03c0\u03cc \u03c0\u03bf\u03b9\u03bf \u03cc\u03c1\u03b3\u03b1\u03bd\u03bf \u03c0\u03c1\u03bf\u03ad\u03c1\u03c7\u03b5\u03c4\u03b1\u03b9 \u03ba\u03ac\u03b8\u03b5 \u03bc\u03ad\u03c4\u03c1\u03b7\u03c3\u03b7. \u03a4\u03bf \u03c3\u03ba\u03b1\u03bb\u03af\u03b4\u03b9 \u03b4\u03b5\u03bd \u03c0\u03b5\u03c1\u03b9\u03b5\u03bb\u03ac\u03bc\u03b2\u03b1\u03bd\u03b5 \u03c4\u03bf \u03cc\u03bd\u03bf\u03bc\u03b1 \u03ae \u03c4\u03b7 \u03b4\u03b9\u03b5\u03cd\u03b8\u03c5\u03bd\u03c3\u03b7 \u03c4\u03bf\u03c5 \u03b9\u03b4\u03b9\u03bf\u03ba\u03c4\u03ae\u03c4\u03b7 \u03c4\u03bf\u03c5 \u03b3\u03b7\u03c2.\n\n\u039f Theodoros \u03b5\u03af\u03c7\u03b5 \u03b4\u03b1\u03bd\u03b5\u03af\u03c3\u03b5\u03b9 \u03c4\u03bf \u03c6\u03bf\u03c1\u03b7\u03c4\u03cc \u03c4\u03c1\u03af\u03c0\u03bf\u03b4\u03bf \u03c4\u03bf\u03c5 \u03c3\u03c4\u03b7\u03bd Iris \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03b5\u03c0\u03b9\u03b8\u03b5\u03ce\u03c1\u03b7\u03c3\u03b7. \u0389\u03c4\u03b1\u03bd \u03c5\u03c0\u03b5\u03cd\u03b8\u03c5\u03bd\u03b7 \u03bd\u03b1 \u03c4\u03bf \u03b5\u03c0\u03b9\u03c3\u03c4\u03c1\u03ad\u03c8\u03b5\u03b9, \u03b1\u03bb\u03bb\u03ac \u03b7 \u03b9\u03b4\u03b9\u03bf\u03ba\u03c4\u03b7\u03c3\u03af\u03b1 \u03b4\u03b5\u03bd \u03b5\u03af\u03c7\u03b5 \u03b1\u03bb\u03bb\u03ac\u03be\u03b5\u03b9. \u0395\u03ac\u03bd \u03ad\u03bd\u03b1\u03c2 \u03b4\u03c5\u03bd\u03b1\u03c4\u03cc\u03c2 \u03ac\u03bd\u03b5\u03bc\u03bf\u03c2 \u03b4\u03b9\u03b1\u03ba\u03cc\u03c0\u03c4\u03b5\u03b9 \u03c4\u03b7 \u03b4\u03bf\u03c5\u03bb\u03b5\u03b9\u03ac, \u03b8\u03b1 \u03c3\u03c5\u03c3\u03ba\u03b5\u03c5\u03ac\u03b6\u03bf\u03bd\u03c4\u03b1\u03bd \u03c4\u03b1 \u03cc\u03c1\u03b3\u03b1\u03bd\u03b1 \u03ba\u03b1\u03b9 \u03b8\u03b1 \u03bf\u03bb\u03bf\u03ba\u03bb\u03b7\u03c1\u03ce\u03bd\u03b1\u03bd \u03c4\u03b7\u03bd \u03b5\u03c0\u03b9\u03b8\u03b5\u03ce\u03c1\u03b7\u03c3\u03b7 \u03bc\u03b9\u03b1 \u03ac\u03bb\u03bb\u03b7 \u03bc\u03ad\u03c1\u03b1. \u0394\u03b5\u03bd \u03b1\u03bd\u03ad\u03c6\u03b5\u03c1\u03b1\u03bd \u03cc\u03c4\u03b9 \u03c3\u03c5\u03bd\u03ad\u03b2\u03b7 \u03c0\u03c1\u03b1\u03b3\u03bc\u03b1\u03c4\u03b9\u03ba\u03ac \u03ad\u03bd\u03b1\u03c2 \u03b4\u03c5\u03bd\u03b1\u03c4\u03cc\u03c2 \u03ac\u03bd\u03b5\u03bc\u03bf\u03c2\u00b7 \u03c0\u03b5\u03c1\u03b9\u03b3\u03c1\u03ac\u03c6\u03bf\u03bd\u03c4\u03b1\u03bd \u03c4\u03b7 \u03b4\u03b9\u03b1\u03b4\u03b9\u03ba\u03b1\u03c3\u03af\u03b1 \u03c0\u03bf\u03c5 \u03b8\u03b1 \u03b1\u03ba\u03bf\u03bb\u03bf\u03c5\u03b8\u03bf\u03cd\u03c3\u03b1\u03bd \u03b5\u03ac\u03bd \u03b1\u03c5\u03c4\u03cc \u03c3\u03c5\u03bd\u03ad\u03b2\u03b1\u03b9\u03bd\u03b5.\n\n\u0397 \u03c3\u03ba\u03b9\u03ce\u03b4\u03b7\u03c2 \u03ad\u03bc\u03b2\u03bf\u03b9\u03bf \u03ad\u03b4\u03b5\u03b9\u03be\u03b5 -5,4 \u03b2\u03b1\u03b8\u03bc\u03bf\u03cd\u03c2 \u039a\u03b5\u03bb\u03c3\u03af\u03bf\u03c5, \u03cc\u03c7\u03b9 54 \u03b2\u03b1\u03b8\u03bc\u03bf\u03cd\u03c2. \u0397 Iris \u03b6\u03ae\u03c4\u03b7\u03c3\u03b5 \u03bd\u03b1 \u03b1\u03bd\u03c4\u03b9\u03b3\u03c1\u03b1\u03c6\u03b5\u03af \u03c4\u03bf \u03b1\u03c1\u03bd\u03b7\u03c4\u03b9\u03ba\u03cc \u03c3\u03c4\u03bf \u03c3\u03b7\u03bc\u03b5\u03af\u03bf \u03b3\u03b9\u03b1 \u03c4\u03b9\u03c2 \u03c3\u03b7\u03bc\u03b5\u03b9\u03ce\u03c3\u03b5\u03b9\u03c2 \u03b5\u03c0\u03b5\u03b9\u03b4\u03ae \u03b7 \u03b1\u03c6\u03b1\u03af\u03c1\u03b5\u03c3\u03ae \u03c4\u03bf\u03c5 \u03b8\u03b1 \u03ac\u03bb\u03bb\u03b1\u03b6\u03b5 \u03c4\u03b7 \u03c3\u03b7\u03bc\u03b1\u03c3\u03af\u03b1. \u039c\u03b9\u03b1 \u03be\u03b5\u03c7\u03c9\u03c1\u03b9\u03c3\u03c4\u03ae \u03b1\u03bd\u03ac\u03b3\u03bd\u03c9\u03c3\u03b7 \u03c5\u03b3\u03c1\u03b1\u03c3\u03af\u03b1\u03c2 \u03ae\u03c4\u03b1\u03bd 68 \u03c4\u03bf \u03c0\u03bf\u03c3\u03bf\u03c3\u03c4\u03cc. \u039a\u03b1\u03bd\u03ad\u03bd\u03b1\u03c2 \u03b1\u03c0\u03cc \u03c4\u03bf\u03c5\u03c2 \u03b4\u03cd\u03bf \u03b4\u03b5\u03bd \u03b9\u03c3\u03c7\u03c5\u03c1\u03af\u03c3\u03c4\u03b7\u03ba\u03b5 \u03cc\u03c4\u03b9 \u03bf\u03b9 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u03c4\u03b7\u03c2 \u03b8\u03b5\u03c1\u03bc\u03bf\u03ba\u03c1\u03b1\u03c3\u03af\u03b1\u03c2 \u03ba\u03b1\u03b9 \u03c4\u03b7\u03c2 \u03c5\u03b3\u03c1\u03b1\u03c3\u03af\u03b1\u03c2 \u03ae\u03c4\u03b1\u03bd \u03b1\u03bc\u03bf\u03b9\u03b2\u03b1\u03af\u03b1 \u03b1\u03bd\u03c4\u03b9\u03ba\u03b1\u03c4\u03ac\u03c3\u03c4\u03b1\u03c4\u03b5\u03c2, \u03ba\u03b1\u03b9 \u03b4\u03b5\u03bd \u03c3\u03c5\u03bc\u03c0\u03b5\u03c1\u03ac\u03c3\u03b1\u03bc\u03b5 \u03b2\u03c1\u03bf\u03c7\u03ae \u03bc\u03cc\u03bd\u03bf \u03b1\u03c0\u03cc \u03c4\u03bf \u03bd\u03bf\u03cd\u03bc\u03b5\u03c1\u03bf \u03c4\u03b7\u03c2 \u03c5\u03b3\u03c1\u03b1\u03c3\u03af\u03b1\u03c2.\n\n\u0388\u03bd\u03b1\u03c2 \u03c4\u03b5\u03c7\u03bd\u03b9\u03ba\u03cc\u03c2 \u03b5\u03af\u03c7\u03b5 \u03b3\u03c1\u03ac\u03c8\u03b5\u03b9: \u00ab\u0395\u03c0\u03b1\u03bd\u03b1\u03c6\u03ad\u03c1\u03b5\u03b9 \u03c4\u03b7\u03bd \u03bf\u03b8\u03cc\u03bd\u03b7 \u03bc\u03b5\u03c4\u03ac \u03c4\u03b7\u03bd \u03b1\u03bd\u03c4\u03b9\u03b3\u03c1\u03b1\u03c6\u03ae \u03c4\u03bf\u03c5 \u03b1\u03c0\u03bf\u03c4\u03b5\u03bb\u03ad\u03c3\u03bc\u03b1\u03c4\u03bf\u03c2\u00bb. \u0397 Iris \u03b4\u03b9\u03ac\u03b2\u03b1\u03c3\u03b5 \u03b1\u03c5\u03c4\u03ae \u03c4\u03b7\u03bd \u03bf\u03b4\u03b7\u03b3\u03af\u03b1 \u03b4\u03c5\u03bd\u03b1\u03c4\u03ac \u03b1\u03bb\u03bb\u03ac \u03b4\u03b5\u03bd \u03ad\u03ba\u03b1\u03bd\u03b5 \u03c4\u03b7\u03bd \u03b5\u03c0\u03b1\u03bd\u03b1\u03c6\u03bf\u03c1\u03ac. \u03a0\u03c1\u03ce\u03c4\u03b1 \u03ae\u03b8\u03b5\u03bb\u03b5 \u03bf Theodoros \u03bd\u03b1 \u03b5\u03c0\u03b9\u03b2\u03b5\u03b2\u03b1\u03b9\u03ce\u03c3\u03b5\u03b9 \u03cc\u03c4\u03b9 \u03b7 \u03b1\u03bd\u03ac\u03b3\u03bd\u03c9\u03c3\u03b7 \u03b5\u03af\u03c7\u03b5 \u03ba\u03b1\u03c4\u03b1\u03b3\u03c1\u03b1\u03c6\u03b5\u03af. \u0397 \u03b1\u03c1\u03c7\u03b9\u03ba\u03ae \u03c0\u03b1\u03c1\u03b1\u03c4\u03ae\u03c1\u03b7\u03c3\u03b7 \u03b8\u03b1 \u03c0\u03b1\u03c1\u03ad\u03bc\u03b5\u03bd\u03b5 \u03c3\u03c4\u03bf log \u03b1\u03ba\u03cc\u03bc\u03b1 \u03ba\u03b1\u03b9 \u03bc\u03b5\u03c4\u03ac \u03c4\u03b7\u03bd \u03b5\u03c0\u03b1\u03bd\u03b1\u03c6\u03bf\u03c1\u03ac \u03c4\u03b7\u03c2 \u03bf\u03b8\u03cc\u03bd\u03b7\u03c2\u00b7 \u03bc\u03b9\u03b1 \u03ba\u03b5\u03bd\u03ae \u03bf\u03b8\u03cc\u03bd\u03b7 \u03b4\u03b5\u03bd \u03ae\u03c4\u03b1\u03bd \u03b1\u03c0\u03cc\u03b4\u03b5\u03b9\u03be\u03b7 \u03cc\u03c4\u03b9 \u03b4\u03b5\u03bd \u03b5\u03af\u03c7\u03b5 \u03bb\u03b7\u03c6\u03b8\u03b5\u03af \u03ba\u03b1\u03bc\u03af\u03b1 \u03bc\u03ad\u03c4\u03c1\u03b7\u03c3\u03b7.\n\n\u039f \u03c4\u03b5\u03bb\u03b9\u03ba\u03cc\u03c2 \u03ad\u03bb\u03b5\u03b3\u03c7\u03bf\u03c2 \u03b1\u03c6\u03bf\u03c1\u03bf\u03cd\u03c3\u03b5 \u03c4\u03bf\u03bd \u03ad\u03bc\u03b2\u03bf\u03bb\u03bf RZ-58. \u03a4\u03bf \u03b4\u03b7\u03bc\u03cc\u03c3\u03b9\u03bf dashboard \u03c4\u03bf\u03c5 \u03bc\u03c0\u03bf\u03c1\u03bf\u03cd\u03c3\u03b5 \u03bd\u03b1 \u03b4\u03b5\u03af\u03be\u03b5\u03b9 \u03c4\u03b9\u03c2 \u03c3\u03c5\u03b3\u03ba\u03b5\u03bd\u03c4\u03c1\u03c9\u03bc\u03ad\u03bd\u03b5\u03c2 \u03b1\u03bd\u03b1\u03b3\u03bd\u03ce\u03c3\u03b5\u03b9\u03c2, \u03b1\u03bb\u03bb\u03ac \u03bf \u03b9\u03b4\u03b9\u03bf\u03ba\u03c4\u03ae\u03c4\u03b7\u03c2 \u03c4\u03bf\u03c5 \u03b1\u03ba\u03b9\u03bd\u03ae\u03c4\u03bf\u03c5 \u03b4\u03b5\u03bd \u03b5\u03af\u03c7\u03b5 \u03b4\u03ce\u03c3\u03b5\u03b9 \u03c4\u03b7 \u03c3\u03c5\u03b3\u03ba\u03b1\u03c4\u03ac\u03b8\u03b5\u03c3\u03ae \u03c4\u03bf\u03c5 \u03b3\u03b9\u03b1 \u03c4\u03b7\u03bd \u03b4\u03b7\u03bc\u03bf\u03c3\u03af\u03b5\u03c5\u03c3\u03b7 \u03c4\u03c9\u03bd \u03b1\u03ba\u03c1\u03b9\u03b2\u03ce\u03bd \u03c3\u03c5\u03bd\u03c4\u03b5\u03c4\u03b1\u03b3\u03bc\u03ad\u03bd\u03c9\u03bd \u03c4\u03b7\u03c2 \u03c4\u03bf\u03c0\u03bf\u03b8\u03b5\u03c3\u03af\u03b1\u03c2. \u0397 \u03b5\u03c0\u03cc\u03bc\u03b5\u03bd\u03b7 \u03b5\u03c0\u03b9\u03b8\u03b5\u03ce\u03c1\u03b7\u03c3\u03b7 \u03ae\u03c4\u03b1\u03bd \u03c0\u03c1\u03bf\u03b3\u03c1\u03b1\u03bc\u03bc\u03b1\u03c4\u03b9\u03c3\u03bc\u03ad\u03bd\u03b7 \u03b3\u03b9\u03b1 \u03c4\u03bf \u03a3\u03ac\u03b2\u03b2\u03b1\u03c4\u03bf \u03c3\u03c4\u03b9\u03c2 10:15. \u0397 Iris \u03b8\u03b1 \u03b5\u03c0\u03ad\u03c3\u03c4\u03c1\u03b5\u03c6\u03b5 \u03c4\u03bf \u03c4\u03c1\u03af\u03c0\u03bf\u03b4\u03bf \u03c3\u03c4\u03bf\u03bd Theodoros \u03c4\u03cc\u03c4\u03b5, \u03ba\u03b1\u03b9 \u03b7 \u03c4\u03c3\u03ac\u03bd\u03c4\u03b1 \u03c0\u03bf\u03c5 \u03ba\u03bf\u03c5\u03b2\u03b1\u03bb\u03bf\u03cd\u03c3\u03b5 \u03c4\u03bf \u03ba\u03b1\u03bc\u03b2\u03ac\u03ba\u03b9 \u03b8\u03b1 \u03ad\u03bc\u03b5\u03bd\u03b5 \u03bc\u03ad\u03c3\u03b1 \u03c3\u03c4\u03bf \u03ba\u03bb\u03b5\u03b9\u03c3\u03c4\u03cc \u03ba\u03b1\u03c4\u03b1\u03c6\u03cd\u03b3\u03b9\u03bf \u03bc\u03ad\u03c7\u03c1\u03b9 \u03b1\u03c5\u03c4\u03ae \u03c4\u03b7\u03bd \u03b5\u03c0\u03af\u03c3\u03ba\u03b5\u03c8\u03b7.",
          "speaker": "Speaker 7"
        }
      ],
