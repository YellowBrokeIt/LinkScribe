{
  "language": "el",
  "segments": [
    {
      "start": 0.0,
      "end": 1.18,
      "text": "There",
      "speaker": "Unknown speaker"
    },
    {
      "start": 1.18,
      "end": 6.68,
      "text": "is no danger of the modern commentators on the Timaeus falling into the absurdities",
      "speaker": "Speaker 1"
    },
    {
      "start": 6.68,
      "end": 8.16,
      "text": "of the Neoplatonists.",
      "speaker": "Speaker 1"
    },
    {
      "start": 9.72,
      "end": 11.6,
      "text": "Jack would become Eva's happy husband",
      "speaker": "Speaker 2"
    },
    {
      "start": 11.6,
      "end": 12.84,
      "text": "and",
      "speaker": "Unknown speaker"
    },
    {
      "start": 12.84,
      "end": 14.34,
      "text": "would remain amidst",
      "speaker": "Speaker 2"
    },
    {
      "start": 14.34,
      "end": 14.56,
      "text": "the",
      "speaker": "Unknown speaker"
    },
    {
      "start": 14.56,
      "end": 15.56,
      "text": "hurried duties of",
      "speaker": "Speaker 2"
    },
    {
      "start": 15.56,
      "end": 16.42,
      "text": "the eager world.",
      "speaker": "Speaker 2"
    },
    {
      "start": 17.8,
      "end": 18.7,
      "text": "In the present day,",
      "speaker": "Speaker 1"
    },
    {
      "start": 19.1,
      "end": 19.3,
      "text": "we",
      "speaker": "Unknown speaker"
    },
    {
      "start": 19.3,
      "end": 23.66,
      "text": "are well aware that an ancient philosopher is to be interpreted",
      "speaker": "Speaker 1"
    },
    {
      "start": 23.66,
      "end": 25.26,
      "text": "from himself and",
      "speaker": "Speaker 1"
    },
    {
      "start": 25.26,
      "end": 25.92,
      "text": "by...",
      "speaker": "Unknown speaker"
    },
    {
      "start": 25.92,
      "end": 26.76,
      "text": "Mr.",
      "speaker": "Unknown speaker"
    },
    {
      "start": 26.9,
      "end": 27.4,
      "text": "Neverbend",
      "speaker": "Speaker 2"
    },
    {
      "start": 27.4,
      "end": 28.28,
      "text": "began",
      "speaker": "Unknown speaker"
    },
    {
      "start": 28.28,
      "end": 31.06,
      "text": "the captain, and I observed that up to that moment",
      "speaker": "Speaker 2"
    },
    {
      "start": 31.06,
      "end": 31.58,
      "text": "he",
      "speaker": "Unknown speaker"
    },
    {
      "start": 31.58,
      "end": 33.0,
      "text": "had generally addressed me as",
      "speaker": "Speaker 2"
    },
    {
      "start": 33.0,
      "end": 33.68,
      "text": "President.",
      "speaker": "Unknown speaker"
    }
  ]
}