      "source_segments": [
        {
          "start": 0.0,
          "end": 7.5,
          "text": "Δεν είπα ότι η Άννα πούλησε όλα τα βιβλία. Είπα ότι δεν πούλησε κανένα χθες.",
          "speaker": "Speaker 3"
        },
        {
          "start": 7.5,
          "end": 12.5,
          "text": "Σήμερα μπορεί να πουλήσει ένα, αλλά αυτό δεν έχει αποφασιστεί.",
          "speaker": "Speaker 3"
        }
      ],
      "reference_translations": [
        "I did not say that Anna sold all the books. I said that she did not sell any yesterday.",
        "She may sell one today, but that has not been decided."
      ],
      "review_criteria": [
        "Preserve both scopes: denial of having said 'sold all', and the positive report that she sold none yesterday.",
        "Do not turn 'did not sell any' into 'did not sell all', which allows some sales.",
        "Today's possible sale remains undecided rather than certain or completed.",
        "Judge complete propositions; merely retaining a token such as 'not' does not establish correct negation."
